{
  "name": "web-nn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "description": "Local FaceMesh blink detection and Live2D avatar for web and Linux desktop.",
  "author": "zeiaibengkui",
  "desktopName": "Blinkline",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dev": "concurrently --kill-others --success first \"vite --host 127.0.0.1 --port 5175 --strictPort\" \"wait-on tcp:127.0.0.1:5175 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5175/ electron .\"",
    "desktop:dir": "pnpm build && electron-builder --linux dir",
    "desktop:build": "pnpm build && electron-builder --linux AppImage",
    "desktop:deb": "pnpm build && electron-builder --linux deb"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "kalidokit": "1.1.5",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "io.github.zeiaibengkui.blinkline",
    "productName": "Blinkline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "executableName": "blinkline",
      "maintainer": "zeiaibengkui <liqi6_6_6@163.com>",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
